# Sentry error monitoring (leave empty to disable locally)
SENTRY_DSN=
ENVIRONMENT=development

# Comma-separated frontend origins (required in production)
ALLOWED_ORIGINS=http://localhost:3000

# Postgres (used by docker-compose)
POSTGRES_PASSWORD=

# Admin portal password — bcrypt hash (NOT plaintext).
# Generate: python -c "from backend.core.security import hash_password; print(hash_password('your_strong_password'))"
ADMIN_SECRET_PASSWORD=

# Email OTP — set EMAIL_PROVIDER=smtp and Gmail App Password to send real emails
EMAIL_PROVIDER=dev
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
