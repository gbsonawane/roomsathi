# Admin portal password — store a bcrypt hash, NOT plaintext.
# Generate with:
#   python -c "from backend.core.security import hash_password; print(hash_password('your_strong_password'))"
ADMIN_SECRET_PASSWORD=

# Sentry error monitoring (leave empty to disable locally)
SENTRY_DSN=
ENVIRONMENT=development

# Comma-separated frontend origins (required in production)
ALLOWED_ORIGINS=http://localhost:3000

# Postgres (used by docker-compose)
POSTGRES_PASSWORD=

# Email OTP (required for login via email)
# Use EMAIL_PROVIDER=smtp with a real Gmail + App Password (not your normal password).
# Create App Password: https://myaccount.google.com/apppasswords  (2FA must be on)
EMAIL_PROVIDER=smtp
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
